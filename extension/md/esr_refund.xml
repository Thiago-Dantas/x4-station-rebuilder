<?xml version="1.0" encoding="utf-8"?>
<mdscript name="ESR_Refund" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Easier Station Rebuilder: full refund for removed modules (G2 part 2, D-6).
    Called by ESR_Main's sweep. Doomed modules are watched with their build cost (the module ware's
    recipe for the station's build method, sent at Confirm; the default recipe otherwise).
    LOG ONLY for now: automated run 3 (2026-10-15, script-made plan change) showed vanilla returning the
    full build cost of the removed modules to build storage, so adding the cost again would double it.
    When a watched module no longer exists, the cost it would add is logged; nothing is added until a
    case with a real shortfall is measured (build menu path, full replacement).
    A module that is no longer doomed (plan changed again) or still stands after the build is dropped
    without a refund. Returns true while the station has watched modules.
  -->
  <cues>
    <cue name="State">
      <actions>
        <!-- module -> table[$station, $macro, $cost] -->
        <do_if value="not md.ESR_Refund.State.$Watch?">
          <set_value name="md.ESR_Refund.State.$Watch" exact="table[]"/>
        </do_if>
      </actions>
    </cue>

    <library name="Sweep" purpose="run_actions">
      <params>
        <param name="Station"/>
        <param name="Doomed"/>
      </params>
      <actions>
        <set_value name="$Watch" exact="md.ESR_Refund.State.$Watch"/>
        <!-- build method id -> race (raceresources falls back to the default recipe when a race has none) -->
        <set_value name="$Method" exact="@md.ESR_Main.Tracker.$BuildMethods.{$Station}"/>
        <set_value name="$Race" exact="null"/>
        <do_for_each name="$Candidate" in="[race.argon, race.boron, race.paranid, race.split, race.teladi, race.terran, race.xenon]">
          <do_if value="$Candidate.id == $Method">
            <set_value name="$Race" exact="$Candidate"/>
            <break/>
          </do_if>
        </do_for_each>
        <set_value name="$Current" exact="table[]"/>
        <do_for_each name="$Module" in="$Doomed">
          <set_value name="$Current.{$Module}" exact="true"/>
          <do_if value="$Module.exists">
            <set_value name="$Watch.{$Module}" exact="table[
              $station = $Station,
              $macro = $Module.macro,
              $cost = if $Race then @$Module.macro.ware.raceresources.{$Race}.table else @$Module.macro.ware.resources.table]"/>
          </do_if>
        </do_for_each>

        <set_value name="$Watching" exact="false"/>
        <do_for_each name="$Module" in="$Watch.keys.list">
          <set_value name="$Entry" exact="$Watch.{$Module}"/>
          <do_if value="$Entry.$station != $Station">
            <continue/>
          </do_if>
          <do_if value="$Current.{$Module}?">
            <set_value name="$Watching" exact="true"/>
            <continue/>
          </do_if>
          <do_if value="$Module.exists">
            <debug_text text="'[ESR] REFUND %s: %s is no longer being removed; no refund'.[$Station.knownname, $Entry.$macro]" filter="general"/>
          </do_if>
          <do_elseif value="not $Entry.$cost">
            <debug_text text="'[ESR] REFUND %s: %s removed, but its build cost is unknown; no refund'.[$Station.knownname, $Entry.$macro]" filter="general"/>
          </do_elseif>
          <do_else>
            <debug_text text="'[ESR] REFUND %s: %s removed; build cost %s; build storage now %s (log only, nothing added)'.[$Station.knownname, $Entry.$macro, $Entry.$cost, @$Station.buildstorage.cargo.table]" filter="general"/>
          </do_else>
          <remove_value name="$Watch.{$Module}"/>
        </do_for_each>
        <return value="$Watching"/>
      </actions>
    </library>
  </cues>
</mdscript>
