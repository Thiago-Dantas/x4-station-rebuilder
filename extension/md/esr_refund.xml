<?xml version="1.0" encoding="utf-8"?>
<mdscript name="ESR_Refund" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Easier Station Rebuild: refund for the equipment of removed modules (G2 part 2, D-6).
    Vanilla refunds the module's own recipe to build storage, but not the turrets and shields on it
    (verified in game and in X4.exe, docs/x4-modding.md "How the engine computes module refunds").
    Where the equipment comes from: ui/esr_confirm.lua sends each removed module's loadout as the build menu
    read it before Confirm (UI event "esr_equipment"). MD searches don't find station equipment
    (automated runs 10-12: not under the module, not recursively, not station-wide), so this is the source.
    Equipment is matched by class nowhere here: any turret or shield macro whose ware has a recipe is priced,
    modded ones included.
    Called by ESR_Main's sweep: the first time a doomed module is seen, its loadout is priced with the recipes
    for the station's build method (sent at Confirm; default recipe otherwise). When the module no longer
    exists, that cost goes to the station's build storage. A module that is no longer doomed (plan changed
    again) or still stands after the build gets nothing. Returns true while the station has watched modules.
  -->
  <cues>
    <cue name="State">
      <actions>
        <!-- module -> table[$station, $macro, $equipment = table[ware -> amount], $count] -->
        <do_if value="not md.ESR_Refund.State.$Watch?">
          <set_value name="md.ESR_Refund.State.$Watch" exact="table[]"/>
        </do_if>
        <!-- module -> table[macro -> count], from the build menu at Confirm -->
        <do_if value="not md.ESR_Refund.State.$Loadouts?">
          <set_value name="md.ESR_Refund.State.$Loadouts" exact="table[]"/>
        </do_if>
      </actions>
      <cues>
        <!-- param3 = [station, module, macro name, count, macro name, count, module, ...] -->
        <cue name="OnEquipment" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'StationConfigurationMenu'" control="'esr_equipment'"/>
          </conditions>
          <actions>
            <!-- created here too: State already ran in saves made with an older version (run 13) -->
            <do_if value="not md.ESR_Refund.State.$Loadouts?">
              <set_value name="md.ESR_Refund.State.$Loadouts" exact="table[]"/>
            </do_if>
            <set_value name="$List" exact="event.param3"/>
            <set_value name="$Module" exact="null"/>
            <set_value name="$Modules" exact="0"/>
            <set_value name="$Items" exact="0"/>
            <set_value name="$i" exact="2"/>
            <do_while value="$i le $List.count">
              <do_if value="typeof $List.{$i} == datatype.component">
                <set_value name="$Module" exact="$List.{$i}"/>
                <set_value name="md.ESR_Refund.State.$Loadouts.{$Module}" exact="table[]"/>
                <set_value name="$Modules" operation="add"/>
                <set_value name="$i" operation="add"/>
              </do_if>
              <do_else>
                <do_if value="$Module and $i lt $List.count">
                  <set_value name="md.ESR_Refund.State.$Loadouts.{$Module}.{macro.{$List.{$i}}}" exact="$List.{$i + 1}" operation="add"/>
                  <set_value name="$Items" exact="$List.{$i + 1}" operation="add"/>
                </do_if>
                <set_value name="$i" exact="$i + 2"/>
              </do_else>
            </do_while>
            <debug_text text="'[ESR] REFUND %s: equipment of removed modules from the build menu: %s pieces on %s modules'.[@$List.{1}.knownname, $Items, $Modules]" filter="general"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <library name="Sweep" purpose="run_actions">
      <params>
        <param name="Station"/>
        <param name="Doomed"/>
      </params>
      <actions>
        <!-- created here too: State already ran in saves made with an older version (run 13) -->
        <do_if value="not md.ESR_Refund.State.$Loadouts?">
          <set_value name="md.ESR_Refund.State.$Loadouts" exact="table[]"/>
        </do_if>
        <set_value name="$Watch" exact="md.ESR_Refund.State.$Watch"/>
        <!-- build method id -> race (raceresources falls back to the default recipe when a race has none) -->
        <set_value name="$Method" exact="@md.ESR_Main.Tracker.$BuildMethods.{$Station}"/>
        <set_value name="$Race" exact="null"/>
        <do_for_each name="$Candidate" in="[race.argon, race.boron, race.paranid, race.split, race.teladi, race.terran, race.xenon]">
          <do_if value="$Candidate.id == $Method">
            <set_value name="$Race" exact="$Candidate"/>
            <break/>
          </do_if>
        </do_for_each>

        <set_value name="$Current" exact="table[]"/>
        <do_for_each name="$Module" in="$Doomed">
          <set_value name="$Current.{$Module}" exact="true"/>
          <do_if value="$Watch.{$Module}? or not $Module.exists">
            <continue/>
          </do_if>
          <set_value name="$Equipment" exact="table[]"/>
          <set_value name="$Count" exact="0"/>
          <set_value name="$Loadout" exact="@md.ESR_Refund.State.$Loadouts.{$Module}"/>
          <do_if value="$Loadout">
            <do_for_each name="$Macro" valuename="$Number" in="$Loadout">
              <set_value name="$Count" exact="$Number" operation="add"/>
              <set_value name="$Recipe" exact="if $Race then @$Macro.ware.raceresources.{$Race}.table else @$Macro.ware.resources.table"/>
              <do_if value="$Recipe">
                <do_for_each name="$Ware" valuename="$Amount" in="$Recipe">
                  <set_value name="$Equipment.{$Ware}" exact="$Amount * $Number" operation="add"/>
                </do_for_each>
              </do_if>
              <do_else>
                <debug_text text="'[ESR] REFUND %s: %s on %s has no ware recipe; it cannot be refunded'.[$Station.knownname, $Macro, $Module.macro]" filter="general"/>
              </do_else>
            </do_for_each>
          </do_if>
          <set_value name="$Watch.{$Module}" exact="table[$station = $Station, $macro = $Module.macro, $equipment = $Equipment, $count = $Count]"/>
        </do_for_each>

        <set_value name="$Watching" exact="false"/>
        <do_for_each name="$Module" in="$Watch.keys.list">
          <set_value name="$Entry" exact="$Watch.{$Module}"/>
          <do_if value="$Entry.$station != $Station">
            <continue/>
          </do_if>
          <do_if value="$Current.{$Module}?">
            <set_value name="$Watching" exact="true"/>
            <continue/>
          </do_if>
          <do_if value="$Module.exists">
            <debug_text text="'[ESR] REFUND %s: %s is no longer being removed; no refund'.[$Station.knownname, $Entry.$macro]" filter="general"/>
          </do_if>
          <do_elseif value="$Entry.$count gt 0">
            <do_for_each name="$Ware" valuename="$Amount" in="$Entry.$equipment">
              <add_cargo object="$Station.buildstorage" ware="$Ware" exact="$Amount"/>
            </do_for_each>
            <debug_text text="'[ESR] REFUND %s: %s removed with %s turrets/shields; refunded %s to build storage'.[$Station.knownname, $Entry.$macro, $Entry.$count, $Entry.$equipment]" filter="general"/>
          </do_elseif>
          <remove_value name="$Watch.{$Module}"/>
          <remove_value name="md.ESR_Refund.State.$Loadouts.{$Module}"/>
        </do_for_each>
        <return value="$Watching"/>
      </actions>
    </library>
  </cues>
</mdscript>
