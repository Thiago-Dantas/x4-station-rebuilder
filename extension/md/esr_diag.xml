<?xml version="1.0" encoding="utf-8"?>
<mdscript name="ESR_Diag" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Easy Station Rebuild: diagnostic logger (MD side). Changes nothing in the game.
    Writes to debuglog.txt (start the game with -debug all -logfile debuglog.txt). Every line starts with "[ESR]".
    - PLAN: when a player station gets a changed plan, which plan entries map to existing modules (kept) and which are new,
      and the station's modules that are not in the new plan (removed), with their build cost, equipment and docked ships.
    - SNAP: station state (modules, builds, build processor, build storage, cargo, workforce, docked ships)
      at the plan change, every 60 s while building, then every 5 min for an hour.
    - EVENT: player builds finished / cancelled, player-owned ships and modules destroyed.
  -->
  <cues>
    <cue name="Diag">
      <actions>
        <!-- station -> table[$done, $next]; $done = game time the build finished (-1 while building) -->
        <set_value name="md.ESR_Diag.Diag.$Tracked" exact="table[]"/>
        <debug_text text="'[ESR] MD logger started, t=%s'.[player.age]" filter="general"/>
      </actions>
      <cues>
        <cue name="OnLoad" instantiate="true">
          <conditions>
            <event_game_loaded/>
          </conditions>
          <actions>
            <debug_text text="'[ESR] MD logger active after load, t=%s, tracking %s station(s)'.[player.age, md.ESR_Diag.Diag.$Tracked.keys.count]" filter="general"/>
          </actions>
        </cue>

        <cue name="OnPlanChange" instantiate="true">
          <conditions>
            <event_player_build_added/>
            <check_value value="event.param.isexpansion"/>
          </conditions>
          <actions>
            <set_value name="$Build" exact="event.param"/>
            <set_value name="$Station" exact="@$Build.base"/>
            <do_if value="$Station and $Station.exists">
              <set_value name="$Seq" exact="$Build.constructionsequence"/>
              <debug_text text="'[ESR] PLAN %s (%s) t=%s build=%s container=%s entries=%s price=%s modules-before=%s'.[$Station.knownname, $Station.idcode, player.age, $Build, event.param2, @$Seq.count, @$Build.price, $Station.modules.all.count]" filter="general"/>

              <!-- plan entries: an entry whose id maps to an existing module keeps that module -->
              <set_value name="$Kept" exact="table[]"/>
              <set_value name="$NumKept" exact="0"/>
              <set_value name="$NumNew" exact="0"/>
              <do_all exact="@$Seq.count" counter="$i">
                <!-- run 3: an entry copied into a variable can't be read; read it through the sequence -->
                <set_value name="$Module" exact="@$Station.planmodule.{$Seq.{$i}.id}"/>
                <do_if value="$Module and $Module.exists">
                  <set_value name="$Kept.{$Module}" exact="$i"/>
                  <set_value name="$NumKept" operation="add"/>
                  <debug_text text="'[ESR] PLAN entry #%s %s id=%s -> existing %s'.[$i, $Seq.{$i}.macro, $Seq.{$i}.id, $Module]" filter="general"/>
                </do_if>
                <do_else>
                  <set_value name="$NumNew" operation="add"/>
                  <debug_text text="'[ESR] PLAN entry #%s %s id=%s -> new'.[$i, $Seq.{$i}.macro, $Seq.{$i}.id]" filter="general"/>
                </do_else>
              </do_all>

              <!-- station modules that no plan entry maps to: these are removed -->
              <set_value name="$NumRemoved" exact="0"/>
              <do_for_each name="$Module" in="$Station.modules.all.list">
                <do_if value="not $Kept.{$Module}?">
                  <set_value name="$NumRemoved" operation="add"/>
                  <debug_text text="'[ESR] PLAN removed %s %s build-cost=%s'.[$Module.macro, $Module, @$Module.macro.ware.resources.table]" filter="general"/>
                  <!-- equipment on it: does vanilla's refund cover it? (compare build storage before and after) -->
                  <find_object_component name="$Equipment" object="$Module" class="[class.weapon, class.shieldgenerator]" checkoperational="false" multiple="true" recursive="true"/>
                  <do_if value="$Equipment.count">
                    <set_value name="$Fitted" exact="table[]"/>
                    <do_for_each name="$Item" in="$Equipment">
                      <do_if value="$Item.container == $Station">
                        <set_value name="$Fitted.{$Item.macro}" exact="1" operation="add"/>
                      </do_if>
                    </do_for_each>
                    <debug_text text="'[ESR] PLAN removed-equipment %s: %s'.[$Module, $Fitted]" filter="general"/>
                  </do_if>
                  <find_dockingbay name="$Bays" object="$Module" multiple="true"/>
                  <do_for_each name="$Bay" in="$Bays">
                    <do_for_each name="$Ship" in="$Bay.docked">
                      <debug_text text="'[ESR] PLAN removed-dock ship %s (%s) %s class=%s docked at %s'.[$Ship.knownname, $Ship.idcode, $Ship, $Ship.class, $Bay]" filter="general"/>
                    </do_for_each>
                  </do_for_each>
                </do_if>
              </do_for_each>
              <debug_text text="'[ESR] PLAN summary %s: entries kept=%s new=%s, modules removed=%s'.[$Station.knownname, $NumKept, $NumNew, $NumRemoved]" filter="general"/>

              <run_actions ref="md.ESR_Diag.Snapshot">
                <param name="Station" value="$Station"/>
                <param name="Tag" value="'plan-change'"/>
              </run_actions>
              <set_value name="md.ESR_Diag.Diag.$Tracked.{$Station}" exact="table[$done = -1, $next = 0]"/>
            </do_if>
            <do_else>
              <debug_text text="'[ESR] PLAN expansion build %s without a station (base=%s)'.[$Build, @$Build.base]" filter="general"/>
            </do_else>
          </actions>
        </cue>

        <cue name="Tick" instantiate="true" checkinterval="60s">
          <conditions>
            <check_value value="md.ESR_Diag.Diag.$Tracked.keys.count gt 0"/>
          </conditions>
          <actions>
            <set_value name="$Finished" exact="[]"/>
            <do_for_each name="$Station" valuename="$State" in="md.ESR_Diag.Diag.$Tracked">
              <do_if value="not $Station.exists">
                <debug_text text="'[ESR] SNAP station %s no longer exists, t=%s'.[$Station, player.age]" filter="general"/>
                <append_to_list name="$Finished" exact="$Station"/>
                <continue/>
              </do_if>
              <set_value name="$Busy" exact="@$Station.buildstorage.builds.inprogress.count + @$Station.buildstorage.builds.queued.count"/>
              <do_if value="$Busy gt 0">
                <run_actions ref="md.ESR_Diag.Snapshot">
                  <param name="Station" value="$Station"/>
                  <param name="Tag" value="'building'"/>
                </run_actions>
                <set_value name="$State.$done" exact="-1"/>
              </do_if>
              <do_elseif value="$State.$done lt 0">
                <run_actions ref="md.ESR_Diag.Snapshot">
                  <param name="Station" value="$Station"/>
                  <param name="Tag" value="'build-done'"/>
                </run_actions>
                <set_value name="$State.$done" exact="player.age"/>
                <set_value name="$State.$next" exact="player.age + 300s"/>
              </do_elseif>
              <do_elseif value="player.age ge $State.$done + 3600s">
                <run_actions ref="md.ESR_Diag.Snapshot">
                  <param name="Station" value="$Station"/>
                  <param name="Tag" value="'end'"/>
                </run_actions>
                <append_to_list name="$Finished" exact="$Station"/>
              </do_elseif>
              <do_elseif value="player.age ge $State.$next">
                <run_actions ref="md.ESR_Diag.Snapshot">
                  <param name="Station" value="$Station"/>
                  <param name="Tag" value="'after-build'"/>
                </run_actions>
                <set_value name="$State.$next" exact="$State.$next + 300s"/>
              </do_elseif>
            </do_for_each>
            <do_for_each name="$Station" in="$Finished">
              <remove_value name="md.ESR_Diag.Diag.$Tracked.{$Station}"/>
            </do_for_each>
          </actions>
        </cue>

        <cue name="OnBuildFinished" instantiate="true">
          <conditions>
            <event_player_build_finished/>
            <check_value value="@event.param3.isexpansion"/>
          </conditions>
          <actions>
            <debug_text text="'[ESR] EVENT build finished %s station=%s t=%s'.[event.param3, @event.param3.base.knownname, player.age]" filter="general"/>
          </actions>
        </cue>

        <cue name="OnBuildFinishedComponents" instantiate="true">
          <conditions>
            <event_player_build_finished_components/>
            <check_value value="@event.param3.isexpansion"/>
          </conditions>
          <actions>
            <debug_text text="'[ESR] EVENT build step done %s station=%s t=%s components=%s'.[event.param3, @event.param3.base.knownname, player.age, event.param2]" filter="general"/>
          </actions>
        </cue>

        <cue name="OnBuildCancelled" instantiate="true">
          <conditions>
            <event_player_build_cancelled/>
          </conditions>
          <actions>
            <debug_text text="'[ESR] EVENT build cancelled %s t=%s'.[event.param, player.age]" filter="general"/>
          </actions>
        </cue>

        <cue name="OnOwnedDestroyed" instantiate="true">
          <conditions>
            <event_player_owned_destroyed/>
            <check_value value="event.param.isclass.ship or event.param.isclass.module"/>
          </conditions>
          <actions>
            <set_value name="$Killed" exact="event.param"/>
            <debug_text text="'[ESR] EVENT destroyed %s (%s) %s macro=%s killer=%s method=%s container=%s dock=%s t=%s'.[@$Killed.knownname, @$Killed.idcode, $Killed, @$Killed.macro, event.param2, event.param3, @$Killed.container.knownname, @$Killed.dock, player.age]" filter="general"/>
          </actions>
        </cue>

        <!-- Station state, one line per topic -->
        <library name="Snapshot" purpose="run_actions">
          <params>
            <param name="Station"/>
            <param name="Tag"/>
          </params>
          <actions>
            <set_value name="$Storage" exact="@$Station.buildstorage"/>
            <set_value name="$Processor" exact="@$Storage.buildprocessor"/>
            <debug_text text="'[ESR] SNAP %s | %s (%s) t=%s | modules all=%s operational=%s construction=%s | builds queued=%s inprogress=%s'.[$Tag, $Station.knownname, $Station.idcode, player.age, $Station.modules.all.count, $Station.modules.operational.count, $Station.modules.construction.count, @$Storage.builds.queued.count, @$Storage.builds.inprogress.count]" filter="general"/>
            <debug_text text="'[ESR] SNAP %s | processor busy=%s waiting-resources=%s waiting-storage=%s recycled=%s needed=%s'.[$Tag, @$Processor.isbusy, @$Processor.iswaitingforresources, @$Processor.iswaitingforstorage, @$Processor.recycled, @$Processor.neededsequenceresources]" filter="general"/>
            <debug_text text="'[ESR] SNAP %s | build storage=%s'.[$Tag, @$Storage.cargo.table]" filter="general"/>
            <debug_text text="'[ESR] SNAP %s | station cargo=%s'.[$Tag, $Station.cargo.table]" filter="general"/>
            <debug_text text="'[ESR] SNAP %s | workforce amounts=%s capacities=%s total=%s/%s optimal=%s'.[$Tag, @$Station.workforce.amounts, @$Station.workforce.capacities, @$Station.workforce.amount, @$Station.workforce.capacity, @$Station.workforce.optimal]" filter="general"/>
            <find_dockingbay name="$Bays" object="$Station" multiple="true"/>
            <set_value name="$NumDocked" exact="0"/>
            <do_for_each name="$Bay" in="$Bays">
              <do_for_each name="$Ship" in="$Bay.docked">
                <set_value name="$NumDocked" operation="add"/>
                <debug_text text="'[ESR] SNAP %s | docked %s (%s) %s at %s'.[$Tag, $Ship.knownname, $Ship.idcode, $Ship, $Bay]" filter="general"/>
              </do_for_each>
            </do_for_each>
            <debug_text text="'[ESR] SNAP %s | docked ships=%s'.[$Tag, $NumDocked]" filter="general"/>
          </actions>
        </library>
      </cues>
    </cue>
  </cues>
</mdscript>
