<?xml version="1.0" encoding="utf-8"?>
<mdscript name="ESR_Ships" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Easier Station Rebuilder: docked ships (G1, D-7). Called by ESR_Main's sweep with the doomed modules.
    A ship docked at a doomed module:
    - the player's, with a pilot: MoveWait order to a free spot near the station (parks there until given new orders);
    - someone else's: asked to undock (its own AI flies off);
    - no pilot: warped to that spot at once.
    The Watch cue checks the ships every 2 s and warps any that is still docked 10 s after the first try.
    (Automated run 6, 2026-10-15: a full replacement put every module into deconstruction ~60 s after Confirm and
    killed two ships whose park order had not got them out; the fallback then waited 60 s and lost the race.
    Modules in deconstruction can't be searched for docks ("Invalid space"), so ships are remembered at Confirm.)
    The ship the player sits in is never touched (logged instead); drones (units) and mass traffic are skipped.
  -->
  <cues>
    <cue name="State">
      <actions>
        <!-- ship -> table[$station, $time] of the first try -->
        <do_if value="not md.ESR_Ships.State.$Tried?">
          <set_value name="md.ESR_Ships.State.$Tried" exact="table[]"/>
        </do_if>
      </actions>
      <cues>
        <cue name="Watch" instantiate="true" checkinterval="2s">
          <conditions>
            <check_value value="md.ESR_Ships.State.$Tried.keys.count gt 0"/>
          </conditions>
          <actions>
            <do_for_each name="$Ship" in="md.ESR_Ships.State.$Tried.keys.list">
              <set_value name="$Entry" exact="md.ESR_Ships.State.$Tried.{$Ship}"/>
              <do_if value="not $Ship.exists">
                <debug_text text="'[ESR] SHIPS %s: %s no longer exists'.[@$Entry.$station.knownname, $Ship]" filter="general"/>
                <remove_value name="md.ESR_Ships.State.$Tried.{$Ship}"/>
              </do_if>
              <do_elseif value="not $Ship.dock">
                <debug_text text="'[ESR] SHIPS %s: %s (%s) has left the dock after %s s'.[@$Entry.$station.knownname, $Ship.knownname, $Ship.idcode, player.age - $Entry.$time]" filter="general"/>
                <remove_value name="md.ESR_Ships.State.$Tried.{$Ship}"/>
              </do_elseif>
              <do_elseif value="player.age gt $Entry.$time + 10s and $Entry.$station.exists">
                <run_actions ref="md.ESR_Ships.WarpOut">
                  <param name="Station" value="$Entry.$station"/>
                  <param name="Ship" value="$Ship"/>
                </run_actions>
                <remove_value name="md.ESR_Ships.State.$Tried.{$Ship}"/>
              </do_elseif>
            </do_for_each>
          </actions>
        </cue>
      </cues>
    </cue>

    <library name="Sweep" purpose="run_actions">
      <params>
        <param name="Station"/>
        <param name="Doomed"/>
      </params>
      <actions>
        <do_for_each name="$Module" in="$Doomed">
          <!-- a module already in deconstruction can't be searched; its ships were taken at Confirm -->
          <do_if value="not $Module.exists or $Module.isconstruction">
            <continue/>
          </do_if>
          <find_dockingbay name="$Bays" object="$Module" multiple="true"/>
          <do_for_each name="$Bay" in="$Bays">
            <do_for_each name="$Ship" in="$Bay.docked">
              <do_if value="$Ship.isunit or $Ship.ismasstraffic or md.ESR_Ships.State.$Tried.{$Ship}?">
                <continue/>
              </do_if>
              <do_if value="$Ship == player.occupiedship">
                <debug_text text="'[ESR] SHIPS %s: player ship %s is docked at a module being removed; not moved'.[$Station.knownname, $Ship.knownname]" filter="general"/>
                <continue/>
              </do_if>
              <do_if value="not $Ship.pilot">
                <run_actions ref="md.ESR_Ships.WarpOut">
                  <param name="Station" value="$Station"/>
                  <param name="Ship" value="$Ship"/>
                </run_actions>
                <continue/>
              </do_if>
              <do_if value="$Ship.isplayerowned">
                <get_safe_pos result="$Pos" sector="$Station.sector" object="$Station" min="$Station.size" max="$Station.size * 2" radius="$Ship.size"/>
                <create_order id="'MoveWait'" object="$Ship" immediate="true">
                  <param name="destination" value="[$Station.sector, $Pos]"/>
                  <param name="timeout" value="0s"/>
                </create_order>
                <debug_text text="'[ESR] SHIPS %s: %s (%s) ordered to park near the station'.[$Station.knownname, $Ship.knownname, $Ship.idcode]" filter="general"/>
              </do_if>
              <do_else>
                <request_undocking ship="$Ship" queuedresult="$Queued" grantedresult="$Granted"/>
                <debug_text text="'[ESR] SHIPS %s: %s (%s, %s) asked to undock'.[$Station.knownname, $Ship.knownname, $Ship.idcode, $Ship.owner]" filter="general"/>
              </do_else>
              <set_value name="md.ESR_Ships.State.$Tried.{$Ship}" exact="table[$station = $Station, $time = player.age]"/>
            </do_for_each>
          </do_for_each>
        </do_for_each>
      </actions>
    </library>

    <!-- Teleport a ship out of its dock to a free spot near the station -->
    <library name="WarpOut" purpose="run_actions">
      <params>
        <param name="Station"/>
        <param name="Ship"/>
      </params>
      <actions>
        <get_safe_pos result="$Pos" sector="$Station.sector" object="$Station" min="$Station.size" max="$Station.size * 2" radius="$Ship.size"/>
        <warp object="$Ship" sector="$Station.sector">
          <safepos value="$Pos" radius="$Ship.size"/>
        </warp>
        <debug_text text="'[ESR] SHIPS %s: %s (%s) warped out of a module being removed (pilot %s); docked now: %s'.[$Station.knownname, $Ship.knownname, $Ship.idcode, $Ship.pilot, $Ship.dock]" filter="general"/>
      </actions>
    </library>
  </cues>
</mdscript>
